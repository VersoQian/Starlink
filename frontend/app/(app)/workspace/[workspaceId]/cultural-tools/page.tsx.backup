'use client'

import { ChangeEvent, useCallback, useEffect, useRef, useState } from 'react'
import clsx from 'clsx'

// 原文件预览组件
function OriginalPreview({ previewState, fileName }: { previewState: OriginalPreviewReady; fileName: string }) {
  const extension = extractExtension(fileName)

  // PDF视觉预览
  if (previewState.kind === 'pdf' && previewState.pages.length > 0) {
    const firstPage = previewState.pages[0]
    if (firstPage.startsWith('PDF_VISUAL_PREVIEW:')) {
      const pdfUrl = firstPage.replace('PDF_VISUAL_PREVIEW:', '')
      const pageCount = typeof window !== 'undefined' ? (window as any).currentPdfPageCount : 0

      const openPdfInNewWindow = () => {
        // 方法1：尝试直接在新标签页打开PDF
        const newWindow = window.open(pdfUrl, '_blank')

        if (!newWindow) {
          // 方法2：如果弹窗被阻止，创建临时链接强制下载
          const link = document.createElement('a')
          link.href = pdfUrl
          link.target = '_blank'
          link.rel = 'noopener noreferrer'
          link.click()
        }
      }

      return (
        <div className="flex flex-col h-full">
          <div className="flex items-center justify-between mb-3 pb-2 border-b border-gray-200">
            <span className="text-sm font-medium text-gray-700">
              PDF文档预览 ({pageCount > 0 ? `${pageCount}页` : '加载中...'})
            </span>
            <div className="flex gap-2">
              <button
                onClick={() => {
                  const link = document.createElement('a')
                  link.href = pdfUrl
                  link.download = fileName
                  link.click()
                }}
                className="px-3 py-1 text-xs bg-blue-500 text-white rounded hover:bg-blue-600 transition-colors"
              >
                下载原文件
              </button>
              <button
                onClick={openPdfInNewWindow}
                className="px-3 py-1 text-xs bg-green-500 text-white rounded hover:bg-green-600 transition-colors"
              >
                新窗口打开
              </button>
            </div>
          </div>
          <div className="flex-1 border border-gray-300 rounded-lg overflow-hidden bg-gray-50">
            <iframe
              src={`${pdfUrl}#view=FitH&toolbar=1&navpanes=1&scrollbar=1`}
              className="w-full h-full"
              title={`PDF预览: ${fileName}`}
              style={{ minHeight: '400px' }}
              onError={(e) => {
                console.error('PDF iframe error:', e)
                const target = e.target as HTMLIFrameElement
                if (target && target.parentNode) {
                  const errorDiv = document.createElement('div')
                  errorDiv.className = 'flex items-center justify-center h-full text-gray-500 p-4'
                  errorDiv.innerHTML = `
                    <div class="text-center">
                      <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      <p class="text-sm mb-2">当前浏览器不支持PDF预览</p>
                      <p class="text-xs text-gray-400 mb-4">请使用"新窗口打开"或"下载原文件"查看</p>
                      <div class="space-x-2">
                        <button onclick="window.open('${pdfUrl}', '_blank')" class="px-4 py-2 bg-indigo-500 text-white text-sm rounded-lg hover:bg-indigo-600 transition-colors mr-2">
                          新窗口打开
                        </button>
                        <a href="${pdfUrl}" download="${fileName}" class="inline-block px-4 py-2 bg-green-500 text-white text-sm rounded-lg hover:bg-green-600 transition-colors">
                          直接下载
                        </a>
                      </div>
                    </div>
                  `
                  target.parentNode.replaceChild(errorDiv, target)
                }
              }}
            />
          </div>
        </div>
      )
    }
  }

  // DOCX视觉预览 (通过Office Online或Google Docs)
  if (previewState.kind === 'html') {
    const htmlContent = previewState.content
    if (htmlContent.startsWith('DOCX_VISUAL_PREVIEW:')) {
      const docxUrl = htmlContent.replace('DOCX_VISUAL_PREVIEW:', '')

      return (
        <div className="flex flex-col h-full">
          <div className="flex items-center justify-between mb-3 pb-2 border-b border-gray-200">
            <span className="text-sm font-medium text-gray-700">
              Word文档预览
            </span>
            <div className="flex gap-2">
              <button
                onClick={() => {
                  const link = document.createElement('a')
                  link.href = docxUrl
                  link.download = fileName
                  link.click()
                }}
                className="px-3 py-1 text-xs bg-blue-500 text-white rounded hover:bg-blue-600 transition-colors"
              >
                下载原文件
              </button>
            </div>
          </div>
          <div className="flex-1 border border-gray-300 rounded-lg overflow-hidden bg-gray-50 p-4">
            <div className="text-center text-gray-500">
              <svg className="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <p className="text-sm mb-2">Word文档预览</p>
              <p className="text-xs text-gray-400 mb-4">点击下方按钮在新窗口中查看</p>
              <button
                onClick={() => window.open(docxUrl, '_blank')}
                className="px-4 py-2 bg-indigo-500 text-white text-sm rounded-lg hover:bg-indigo-600 transition-colors"
              >
                在新窗口打开文档
              </button>
            </div>
          </div>
        </div>
      )
    }

    // HTML内容预览
    return (
      <div className="flex flex-col h-full">
        <div className="flex items-center justify-between mb-3 pb-2 border-b border-gray-200">
          <span className="text-sm font-medium text-gray-700">
            文档内容预览
          </span>
        </div>
        <div
          className="flex-1 overflow-y-auto text-sm text-gray-700 leading-relaxed bg-white border border-gray-200 rounded-lg p-4"
          dangerouslySetInnerHTML={{ __html: htmlContent }}
        />
      </div>
    )
  }

  // 普通文本预览
  return (
    <div className="flex flex-col h-full">
      <div className="flex items-center justify-between mb-3 pb-2 border-b border-gray-200">
        <span className="text-sm font-medium text-gray-700">
          文件内容预览 ({extension.toUpperCase()})
        </span>
        <div className="flex gap-2">
          <button
            onClick={() => {
              const blob = new Blob([previewState.plainText], { type: 'text/plain' })
              const url = URL.createObjectURL(blob)
              const link = document.createElement('a')
              link.href = url
              link.download = fileName
              link.click()
              URL.revokeObjectURL(url)
            }}
            className="px-3 py-1 text-xs bg-blue-500 text-white rounded hover:bg-blue-600 transition-colors"
          >
            下载原文件
          </button>
        </div>
      </div>
      <div className="flex-1 overflow-y-auto bg-white border border-gray-200 rounded-lg p-4">
        <pre className="whitespace-pre-wrap break-words text-gray-700 text-sm leading-relaxed">
          {previewState.plainText || ''}
        </pre>
      </div>
    </div>
  )
}

const translationPresets = ['繁简互转', '方言适配', '双语校对', '语气微调']

const heroHighlights = [
  {
    title: '智能对照',
    description: '段落级双语展示，快速定位译文差异'
  },
  {
    title: '格式保真',
    description: '保留 PDF / Word 样式，保持上下文'
  },
