    title: '批注友好',
    description: '导出 Markdown / DOCX，便于回传修改'
  }
]

const exportOptions = [
  { id: 'txt', label: '导出 TXT', description: '纯文本格式，方便继续加工' },
  { id: 'md', label: '导出 Markdown', description: '适合知识库与版本管理' },
