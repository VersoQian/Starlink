]

const previewableTextExtensions = new Set(['txt', 'md', 'markdown', 'csv', 'tsv', 'json'])
const htmlPreviewExtensions = new Set(['html', 'htm'])
const docxExtensions = new Set(['docx'])
const MAX_PDF_PREVIEW_PAGES = 3
const MAX_PDF_TEXT_PAGES = 10
const PREVIEW_TEXT_LENGTH_LIMIT = 2000
const LARGE_FILE_THRESHOLD = 5 * 1024 * 1024
const TRANSLATION_INPUT_PLACEHOLDER =
  '示例：请将这份合作函翻译成英文，并保留所有专有名词不变。'
const TRANSLATION_OUTPUT_PLACEHOLDER = '翻译结果会显示在这里，可切换对照模式逐段审阅。'

type OriginalPreviewReady =
  | { status: 'ready'; kind: 'text'; content: string; plainText: string }
  | { status: 'ready'; kind: 'html'; content: string; plainText: string }
  | { status: 'ready'; kind: 'pdf'; pages: string[]; plainText: string }

type OriginalPreviewState =
  | { status: 'idle' }
  | { status: 'loading' }
  | { status: 'error'; message: string }
  | OriginalPreviewReady

function extractExtension(fileName: string): string {
  return fileName.split('.').pop()?.toLowerCase() ?? ''
}

function stripHtmlTags(html: string): string {
  if (typeof window === 'undefined') return ''
  const container = document.createElement('div')
  container.innerHTML = html
  return container.textContent?.replace(/\s+/g, ' ').trim() ?? ''
}

function buildComparisonPairs(
  original: string | null,
  translation: string
): Array<{ source: string; target: string; index: number }> {
  const sourceSegments = original ? splitIntoSegments(original) : []
  const targetSegments = splitIntoSegments(translation)
  const maxLength = Math.max(sourceSegments.length, targetSegments.length)

  const pairs: Array<{ source: string; target: string; index: number }> = []
  for (let index = 0; index < maxLength; index += 1) {
    const source = sourceSegments[index] ?? ''
    const target = targetSegments[index] ?? ''
    if (!source && !target) continue
    pairs.push({ source, target, index })
  }
  return pairs
}

function splitIntoSegments(text: string): string[] {
  const normalized = text.trim()
  if (!normalized) return []

  const paragraphSegments = normalized
    .split(/\r?\n\s*\r?\n/g)
    .map((item) => item.trim())
    .filter((item) => item.length > 0)

  if (paragraphSegments.length > 0) {
    return paragraphSegments
  }

  return normalized
    .split(/\r?\n/g)
    .map((item) => item.trim())
    .filter((item) => item.length > 0)
}

type PdfJsLib = {
  getDocument: (params: { data: ArrayBuffer }) => {
    promise: Promise<{
      numPages: number
      getPage(pageNumber: number): Promise<{
        getViewport: (options: { scale: number }) => { width: number; height: number }
        render: (options: {
          canvasContext: CanvasRenderingContext2D
          viewport: { width: number; height: number }
        }) => { promise: Promise<void> }
        getTextContent: () => Promise<{
          items: Array<{ str?: string }>
        }>
      }>
    }>
  }
  GlobalWorkerOptions: {
    workerSrc: string
  }
}

type PdfWindow = Window & {
  pdfjsLib?: PdfJsLib
}

let pdfJsLoader: Promise<PdfJsLib> | null = null

async function ensurePdfJs(): Promise<PdfJsLib> {
  if (typeof window === 'undefined') {
    throw new Error('PDF 预览仅在浏览器环境中可用。')
  }

  const pdfWindow = window as PdfWindow
  if (pdfWindow.pdfjsLib) {
    return pdfWindow.pdfjsLib
  }

  if (!pdfJsLoader) {
    pdfJsLoader = (async () => {
      const pdfModule = await import('pdfjs-dist/build/pdf')

      // 完全禁用worker设置，直接使用fake worker
      pdfModule.GlobalWorkerOptions.workerSrc = ''
      console.log('PDF.js worker disabled, using fake worker')
      pdfWindow.pdfjsLib = pdfModule
      return pdfModule
    })().catch((error) => {
      pdfJsLoader = null
      console.error('PDF.js loading error:', error)
      throw new Error(
        error instanceof Error
          ? `PDF 预览库加载失败：${error.message}`
          : 'PDF 预览库加载失败，请确认已安装 pdfjs-dist。'
      )
    })
  }

  return pdfJsLoader
}

async function createPdfPreview(file: File): Promise<{ pages: string[]; plainText: string }> {
  console.log('Starting PDF visual preview for file:', file.name)

  const fileSizeKB = (file.size / 1024).toFixed(1)
  const fileName = file.name.replace(/\.[^/.]+$/, '')

  try {
    // 首先尝试创建PDF的URL用于预览
    const pdfUrl = URL.createObjectURL(file)
    console.log('Created PDF URL:', pdfUrl)

    // 验证文件是否为有效的PDF
    const arrayBuffer = await file.arrayBuffer()
    const uint8Array = new Uint8Array(arrayBuffer)

    // 检查PDF文件头
    const pdfHeader = String.fromCharCode(...uint8Array.slice(0, 4))
    if (pdfHeader !== '%PDF') {
      console.warn('File does not have valid PDF header')
      throw new Error('文件不是有效的PDF格式')
    }

    console.log('PDF header validation passed')

    // 尝试获取PDF页数
    let pageCount = 0
    try {
      console.log('Loading PDF.js...')
      const pdfModule = await import('pdfjs-dist/build/pdf')

      // 设置worker配置
      pdfModule.GlobalWorkerOptions.workerSrc = ''

      console.log('Loading PDF document...')
      const loadingTask = pdfModule.getDocument({
        data: arrayBuffer,
        // 禁用一些可能有问题的功能
        disableAutoFetch: true,
        disableStream: true
      })

      const pdf = await loadingTask.promise
      pageCount = pdf.numPages
      console.log(`PDF loaded successfully with ${pageCount} pages`)

    } catch (countError) {
      console.warn('Could not count PDF pages:', countError)
      // 即使无法获取页数，也继续尝试预览
      pageCount = Math.ceil(file.size / 50000) // 估算页数
    }

    // 存储PDF URL供预览组件使用
    if (typeof window !== 'undefined') {
      (window as any).currentPdfUrl = pdfUrl
      (window as any).currentPdfPageCount = pageCount
    }

    return {
      pages: [`PDF_VISUAL_PREVIEW:${pdfUrl}`], // 特殊标记表示这是视觉预览
      plainText: `PDF文件 "${file.name}" 已准备好预览

文件信息：
• 文件大小：${fileSizeKB} KB
• 文件类型：PDF文档
• 页数：${pageCount}页
• 文件名称：${fileName}

预览说明：
��� 下方显示PDF原文档的视觉预览
• 支持缩放和页面导航
• AI翻译将处理完整的PDF内容

当前设置的目标语言：${typeof window !== 'undefined' && (window as any).currentTargetLanguage || '请在下方设置'}

请在右侧设置目标语言并点击"开始翻译"。`
    }

  } catch (error) {
    console.error('PDF preview failed:', error)

    // 尝试降级方案：直接使用文件URL
    try {
      console.log('Attempting fallback preview method...')
      const fallbackUrl = URL.createObjectURL(file)

      if (typeof window !== 'undefined') {
        (window as any).currentPdfUrl = fallbackUrl
        (window as any).currentPdfPageCount = 0
      }

      return {
        pages: [`PDF_VISUAL_PREVIEW:${fallbackUrl}`],
        plainText: `PDF文件 "${file.name}" 已上传

文件信息：
• 文件大小：${fileSizeKB} KB
• 文件类型：PDF文档
• 文件名称：${fileName}

预览说明：
• 使用浏览器直接预览PDF文件
• 如果预览有问题，请下载文件查看
• AI翻译将处理完整的PDF内容

当前设置的目标语言：${typeof window !== 'undefined' && (window as any).currentTargetLanguage || '请在下方设置'}

请在右侧设置目标语言并点击"开始翻译"。`
      }
    } catch (fallbackError) {
      console.error('Fallback preview also failed:', fallbackError)

      return {
        pages: [],
        plainText: `PDF文件 "${file.name}" 已上传

文件信息：
• 文件大小：${fileSizeKB} KB
• 文件类型：PDF文档
• 文件名称：${fileName}

注意：PDF预览遇到问题，可能是文件损坏或格式不支持。
AI翻译仍将尝试处理PDF文件内容。

建议：
• 确认PDF文件没有密码保护
• 尝试重新导出PDF文件
• 如果问题持续，可以使用下载功能直接查看文件`
      }
    }
  }
}

async function createDocxPreview(file: File): Promise<{ html: string; plainText: string }> {
  console.log('Starting DOCX visual preview for file:', file.name)

  try {
    // 创建DOCX文件的URL用于预览
    const docxUrl = URL.createObjectURL(file)
    const fileSizeKB = (file.size / 1024).toFixed(1)
    const fileName = file.name.replace(/\.[^/.]+$/, '')

    // 存储DOCX URL供预览组件使用
    if (typeof window !== 'undefined') {
      (window as any).currentDocxUrl = docxUrl
    }

    // 同时提取文本用于对照
    const mammoth = await import('mammoth/mammoth.browser')
    const arrayBuffer = await file.arrayBuffer()
    const result = await mammoth.convertToHtml({ arrayBuffer })
    const html = result.value ?? ''
    const plainText = stripHtmlTags(html)

    return {
      html: `DOCX_VISUAL_PREVIEW:${docxUrl}`,
      plainText: `Word文档 "${file.name}" 已准备好预览

文件信息：
• 文件大小：${fileSizeKB} KB
• 文件类型：Word文档
• 文件名称：${fileName}

预览说明：
• 下方显示Word文档的视觉预览
• 保持原始格式和样式
• AI翻译将处理完整的文档内容

文本内容预览：
${plainText.slice(0, 1000)}${plainText.length > 1000 ? '...' : ''}

当前设置的目标语言：${typeof window !== 'undefined' && (window as any).currentTargetLanguage || '请在下方设置'}

请在右侧设置目标语言并点击"开始翻译"。`
    }

  } catch (error) {
    console.error('DOCX preview failed:', error)

    // 降级到文本提取
    try {
      const mammoth = await import('mammoth/mammoth.browser')
      const arrayBuffer = await file.arrayBuffer()
      const result = await mammoth.convertToHtml({ arrayBuffer })
      const html = result.value ?? ''
      const plainText = stripHtmlTags(html)
      return { html, plainText }
    } catch (textError) {
      console.error('DOCX text extraction also failed:', textError)
      throw new Error('无法预览此Word文档')
    }
  }
}

function createDownloadLink(blob: Blob, filename: string) {
  const url = URL.createObjectURL(blob)
  const anchor = document.createElement('a')
  anchor.href = url
  anchor.download = filename
  document.body.appendChild(anchor)
  anchor.click()
  document.body.removeChild(anchor)
  URL.revokeObjectURL(url)
}

export default function CulturalToolsPage() {
  const [inputText, setInputText] = useState('')
  const [selectedPreset, setSelectedPreset] = useState<string | null>(null)
  const [selectedExport, setSelectedExport] = useState<string>('txt')
  const fileInputRef = useRef<HTMLInputElement | null>(null)
  const [selectedFile, setSelectedFile] = useState<File | null>(null)
  const [targetLanguage, setTargetLanguage] = useState('英语')
  const [translationResult, setTranslationResult] = useState('')
  const [streamingTranslation, setStreamingTranslation] = useState('')
  const [translationUsage, setTranslationUsage] = useState<number | null>(null)
  const [translationError, setTranslationError] = useState<string | null>(null)
  const [isTranslating, setIsTranslating] = useState(false)
  const [previewMode, setPreviewMode] = useState<'translation' | 'comparison'>('translation')
  const [comparisonPairs, setComparisonPairs] = useState<
    Array<{ source: string; target: string; index: number }>
  >([])
  const [originalPreviewState, setOriginalPreviewState] = useState<OriginalPreviewState>({
    status: 'idle'
  })
  const [exportMessage, setExportMessage] = useState<
    { kind: 'info' | 'success' | 'error'; text: string } | null
  >(null)
  const [isExporting, setIsExporting] = useState(false)
  const previewAutoSwitchRef = useRef(false)
  const [isCompareWindowOpen, setIsCompareWindowOpen] = useState(false)
  const [previewExpanded, setPreviewExpanded] = useState(false)
  const [isFlipped, setIsFlipped] = useState(false) // 翻转状态
  const [compareViewMode, setCompareViewMode] = useState<'side-by-side' | 'flip'>('side-by-side') // 对照模式：左右并排或翻转
  const [isCompareFlipped, setIsCompareFlipped] = useState(false) // 全屏对照窗口的翻转状态

  const translationViewText = isTranslating
    ? streamingTranslation || 'AI 正在翻译中，请稍候……'
    : translationResult || streamingTranslation || TRANSLATION_OUTPUT_PLACEHOLDER
  const hasComparisonView = comparisonPairs.length > 0
  const showComparison = hasComparisonView && previewMode === 'comparison'
  const comparisonSourceText =
    originalPreviewState.status === 'ready' ? originalPreviewState.plainText : null
  const hasTranslation = (translationResult || streamingTranslation).trim().length > 0

  const loadOriginalPreview = useCallback(
    async (file: File): Promise<OriginalPreviewReady> => {
      const extension = extractExtension(file.name)

      if (file.type.startsWith('text/') || previewableTextExtensions.has(extension)) {
        const text = await file.text()
        const isLargeFile = file.size > LARGE_FILE_THRESHOLD
        const displayText = isLargeFile ? text.slice(0, PREVIEW_TEXT_LENGTH_LIMIT) : text
        return {
          status: 'ready',
          kind: 'text',
          content: displayText,
          plainText: isLargeFile ? text.slice(0, PREVIEW_TEXT_LENGTH_LIMIT) : text
        }
      }

      if (htmlPreviewExtensions.has(extension)) {
        const html = await file.text()
        const plainText = stripHtmlTags(html)
        const isLargeFile = file.size > LARGE_FILE_THRESHOLD
        const displayHtml = isLargeFile ? html.slice(0, PREVIEW_TEXT_LENGTH_LIMIT) : html
        return {
          status: 'ready',
          kind: 'html',
          content: displayHtml,
          plainText: (isLargeFile ? plainText.slice(0, PREVIEW_TEXT_LENGTH_LIMIT) : plainText) || displayHtml
        }
      }

      if (extension === 'pdf') {
        const { pages, plainText } = await createPdfPreview(file)
        return {
          status: 'ready',
          kind: 'pdf',
          pages,
          plainText
        }
      }

      if (docxExtensions.has(extension)) {
        const { html, plainText } = await createDocxPreview(file)
        return {
          status: 'ready',
          kind: 'html',
          content: html,
          plainText
        }
      }

      const fallbackText = await file.text().catch(() => null)
      if (fallbackText) {
        return {
          status: 'ready',
          kind: 'text',
          content: fallbackText,
          plainText: fallbackText
        }
      }

      throw new Error('暂不支持当前文件类型，请尝试上传 PDF、Docx 或文本文件。')
    },
    []
  )

  useEffect(() => {
    let cancelled = false

    if (!selectedFile) {
      setOriginalPreviewState({ status: 'idle' })
      return () => {
        cancelled = true
      }
    }

    setOriginalPreviewState({ status: 'loading' })

    loadOriginalPreview(selectedFile)
      .then((result) => {
        if (!cancelled) {
          setOriginalPreviewState(result)
        }
      })
      .catch((error) => {
        if (!cancelled) {
          const message =
            error instanceof Error
              ? error.message
              : '读取原文失败，建议改用 PDF、Docx 或文本文件。'
          setOriginalPreviewState({ status: 'error', message })
        }
      })

    return () => {
      cancelled = true
    }
  }, [selectedFile, loadOriginalPreview])

  useEffect(() => {
    if (!translationResult) {
      setComparisonPairs([])
      return
    }

    setComparisonPairs(buildComparisonPairs(comparisonSourceText, translationResult))
  }, [translationResult, comparisonSourceText])

  useEffect(() => {
    if (!hasComparisonView) {
      previewAutoSwitchRef.current = false
      if (previewMode === 'comparison') {
        setPreviewMode('translation')
      }
      return
    }

    if (previewMode === 'translation' && !previewAutoSwitchRef.current) {
      previewAutoSwitchRef.current = true
      setPreviewMode('comparison')
    }
  }, [hasComparisonView, previewMode])

  const handleFileChange = (event: ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0]
    if (!file) {
      setSelectedFile(null)
      return
    }

    const MAX_SIZE = 15 * 1024 * 1024
    if (file.size > MAX_SIZE) {
      setTranslationError('文件超过 15MB 上限，请压缩或拆分后再试。')
      setSelectedFile(null)
      event.target.value = ''
      return
    }

    setTranslationError(null)
    setSelectedFile(file)
    setTranslationResult('')
    setTranslationUsage(null)
    setPreviewMode('translation')
    setComparisonPairs([])
    setOriginalPreviewState({ status: 'idle' })
    previewAutoSwitchRef.current = false
    setExportMessage(null)
    setIsCompareWindowOpen(false)
  }

  const handleRemoveFile = () => {
    setSelectedFile(null)
    setTranslationResult('')
    setStreamingTranslation('')
    setTranslationUsage(null)
    setPreviewMode('translation')
    setComparisonPairs([])
    setOriginalPreviewState({ status: 'idle' })
    previewAutoSwitchRef.current = false
    setExportMessage(null)
    setIsCompareWindowOpen(false)
    if (fileInputRef.current) {
      fileInputRef.current.value = ''
    }
  }

  const handleExecute = async () => {
    if (!selectedFile) {
      setTranslationError('请先上传需要翻译的文件。')
      return
    }

    const trimmedTarget = targetLanguage.trim()
    if (!trimmedTarget) {
      setTranslationError('请填写目标语言。')
      return
    }

    setIsTranslating(true)
    setTranslationError(null)
    setTranslationResult('')
    setStreamingTranslation('')
    setTranslationUsage(null)
    setPreviewMode('translation')
    setComparisonPairs([])
    previewAutoSwitchRef.current = false
    setExportMessage(null)
    setIsCompareWindowOpen(false)

    try {
      const form = new FormData()
      form.append('file', selectedFile)
      form.append('targetLanguage', trimmedTarget)
      if (inputText.trim()) {
        form.append('instructions', inputText.trim())
      }
      if (selectedPreset) {
        form.append('preset', selectedPreset)
      }

      const response = await fetch('/api/file-translation', {
        method: 'POST',
        body: form
      })

      if (!response.ok) {
        const detailText = await response.text()
        let message = detailText
        try {
          const parsed = JSON.parse(detailText)
          if (parsed && typeof parsed.message === 'string') {
            message = parsed.message
          }
        } catch {
          // ignore parsing failure
        }
        throw new Error(message || '文件翻译失败，请稍后重试。')
      }

      const data = (await response.json()) as {
        translation?: string
        original?: string
        usage?: { total_tokens?: number }
        raw?: any
      }

      console.log('Translation API response:', data)

      let resolvedTranslation = ''
      let extractedOriginal = ''

      // 处理Dify返回的可能包含原文和译文的结构
      if (data.translation && typeof data.translation === 'string' && data.translation.trim().length > 0) {
        resolvedTranslation = data.translation.trim()
      }

      // 尝试从raw数据中提取原文和译文对照信息
      if (data.raw && typeof data.raw === 'object') {
        try {
          // 检查是否有对照数据结构
          if (data.raw.original && typeof data.raw.original === 'string') {
            extractedOriginal = data.raw.original.trim()
          }

          // 检查是否有更复杂的结构，比如段落对照
          if (data.raw.data && Array.isArray(data.raw.data)) {
            for (const item of data.raw.data) {
              if (item.original && typeof item.original === 'string') {
                if (extractedOriginal) extractedOriginal += '\n\n'
                extractedOriginal += item.original.trim()
              }
              if (item.translation && typeof item.translation === 'string') {
                if (resolvedTranslation) resolvedTranslation += '\n\n'
                resolvedTranslation += item.translation.trim()
              }
            }
          }

          // 检查outputs字段中的对照信息
          if (data.raw.outputs && Array.isArray(data.raw.outputs)) {
            for (const output of data.raw.outputs) {
              if (output.original && typeof output.original === 'string') {
                if (extractedOriginal) extractedOriginal += '\n\n'
                extractedOriginal += output.original.trim()
              }
              if (output.translation && typeof output.translation === 'string') {
                if (resolvedTranslation) resolvedTranslation += '\n\n'
                resolvedTranslation += output.translation.trim()
              }
            }
          }
        } catch (parseError) {
          console.warn('Failed to parse structured translation data:', parseError)
        }
      }

      setTranslationResult(resolvedTranslation)
      setStreamingTranslation('') // 清空流式文本
      setTranslationUsage(
        typeof data.usage?.total_tokens === 'number' ? data.usage.total_tokens : null
      )

      // 如果提取到了原文内容，更新对照对
      if (extractedOriginal && resolvedTranslation) {
        console.log('Building comparison pairs from extracted content')
        const pairs = buildComparisonPairs(extractedOriginal, resolvedTranslation)
        setComparisonPairs(pairs)

        // 自动切换到对照模式
        if (pairs.length > 1) {
          setPreviewMode('comparison')
          previewAutoSwitchRef.current = true
        }
      } else if (resolvedTranslation) {
        // 如果只有译文，尝试与本地预览的原文构建对照
        const localOriginal = originalPreviewState.status === 'ready' ? originalPreviewState.plainText : null
        if (localOriginal && localOriginal.trim().length > 0) {
          console.log('Building comparison pairs from local preview')
          const pairs = buildComparisonPairs(localOriginal, resolvedTranslation)
          setComparisonPairs(pairs)

          // 自动切换到对照模式
          if (pairs.length > 1) {
            setPreviewMode('comparison')
            previewAutoSwitchRef.current = true
          }
        }
      }
    } catch (error) {
      setTranslationError(error instanceof Error ? error.message : '文件翻译失败，请重试。')
    } finally {
      setIsTranslating(false)
    }
  }

  const handleExport = useCallback(async () => {
    if (!hasTranslation) {
      setExportMessage({
        kind: 'info',
        text: '请先执行翻译并确认返回内容，再选择导出格式。'
      })
      return
    }

    setIsExporting(true)
    setExportMessage(null)

    const finalTranslation = translationResult || streamingTranslation

    const safeTarget = targetLanguage.trim()
    const filenameBase = selectedFile
      ? selectedFile.name.replace(/\.[^/.]+$/, '')
      : 'translation'
    const suffix = safeTarget ? `-${safeTarget}` : ''
    const timestamp = new Date().toISOString().replace(/[:.]/g, '-')

    try {
      if (selectedExport === 'txt') {
        const blob = new Blob([finalTranslation], {
          type: 'text/plain;charset=utf-8'
        })
        createDownloadLink(blob, `${filenameBase}${suffix}-${timestamp}.txt`)
      } else if (selectedExport === 'md') {
        const header = safeTarget ? `# ${safeTarget} 译文\n\n` : ''
        const content = `${header}${finalTranslation}`
        const blob = new Blob([content], {
          type: 'text/markdown;charset=utf-8'
        })
        createDownloadLink(blob, `${filenameBase}${suffix}-${timestamp}.md`)
      } else if (selectedExport === 'docx') {
        const docx = await import('docx')
        const { Document, Paragraph, TextRun, Packer } = docx
        const blocks = finalTranslation.split(/\r?\n\s*\r?\n/g)
        const paragraphs =
          blocks.length > 0
            ? blocks.map((block) => {
                const lines = block.split(/\r?\n/g)
                const runs = lines.map(
                  (line, index) =>
                    new TextRun({
                      text: line,
                      break: index > 0 ? 1 : undefined
                    })
                )
                return new Paragraph({
                  children: runs.length > 0 ? runs : [new TextRun({ text: '' })]
                })
              })
            : [new Paragraph({ children: [new TextRun({ text: '' })] })]

        const doc = new Document({
          sections: [
            {
              properties: {},
              children: paragraphs
            }
          ]
        })

        const blob = await Packer.toBlob(doc)
        createDownloadLink(blob, `${filenameBase}${suffix}-${timestamp}.docx`)
      } else if (selectedExport === 'pdf') {
        const jspdf = await import('jspdf')
        const { jsPDF } = jspdf
        const doc = new jsPDF({ unit: 'pt', format: 'a4' })
        const margin = 48
        const lineHeight = 16
        const pageWidth = doc.internal.pageSize.getWidth()
        const pageHeight = doc.internal.pageSize.getHeight()
        const maxWidth = pageWidth - margin * 2
        const lines = doc.splitTextToSize(finalTranslation, maxWidth)
        let y = margin
        lines.forEach((line) => {
          if (y > pageHeight - margin) {
            doc.addPage()
            y = margin
          }
          doc.text(line, margin, y)
          y += lineHeight
        })
        const blob = doc.output('blob')
        createDownloadLink(blob, `${filenameBase}${suffix}-${timestamp}.pdf`)
      }

      setExportMessage({
        kind: 'success',
        text: '译文已开始下载，如未看到文件请检查浏览器下载列表。'
      })
    } catch (error) {
      setExportMessage({
        kind: 'error',
        text: error instanceof Error ? `导出失败：${error.message}` : '导出失败，请稍后重试。'
      })
    } finally {
      setIsExporting(false)
    }
  }, [hasTranslation, selectedExport, translationResult, streamingTranslation, selectedFile, targetLanguage])

  const formatFileSize = (size: number) => {
    if (size >= 1024 * 1024) {
      return `${(size / (1024 * 1024)).toFixed(1)} MB`
    }
    if (size >= 1024) {
      return `${(size / 1024).toFixed(1)} KB`
    }
    return `${size} B`
  }

  return (
    <>
      <div className="relative min-h-screen overflow-hidden bg-gradient-to-br from-[#F3F6FF] via-white to-[#F8F4FF]">
        <div className="pointer-events-none absolute -top-32 -right-24 h-72 w-72 rounded-full bg-indigo-200/45 blur-3xl" />
        <div className="pointer-events-none absolute top-1/3 -left-24 h-80 w-80 rounded-full bg-purple-200/35 blur-3xl" />
        <div className="pointer-events-none absolute bottom-[-120px] right-[-80px] h-96 w-96 rounded-full bg-blue-200/25 blur-3xl" />
        <div className="relative z-10">
          <div className="mx-auto max-w-7xl px-6 pt-12">
            <div className="rounded-3xl border border-white/70 bg-white/80 px-8 py-8 shadow-xl shadow-indigo-100/60 backdrop-blur-xl">
              <div className="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
                <div className="flex items-start gap-4">
                  <div className="relative">
                    <div className="absolute -inset-3 rounded-2xl bg-gradient-to-br from-indigo-300/70 via-purple-300/60 to-purple-200/60 blur-xl" />
                    <div className="relative flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 text-white shadow-lg shadow-indigo-200/60">
                      <svg className="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.23 5.012 5.432 0 3.432 0 1.25 3.2 1.25 7v3c0 4.418 2.69 8.167 6.5 9.75" />
                      </svg>
                    </div>
                  </div>
                  <div className="space-y-3">
                    <p className="text-xs font-semibold uppercase tracking-[0.3em] text-indigo-500">
                      跨文化助手
                    </p>
                    <h1 className="text-3xl font-bold text-slate-900 sm:text-4xl">智能翻译工作台</h1>
                    <p className="text-sm leading-relaxed text-slate-600">
                      支持 PDF / Word / Markdown 等多格式上传，提供实时视觉预览、段落级双语对照与一键导出能力，打造跨文化协作的流畅体验。
                    </p>
                    <div className="flex flex-wrap gap-2">
                      {translationPresets.map((preset) => (
                        <span
                          key={preset}
                          className="rounded-full border border-indigo-100/60 bg-indigo-50/80 px-3 py-1 text-xs font-medium text-indigo-600 shadow-sm"
                        >
                          {preset}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
                <div className="grid w-full gap-3 sm:grid-cols-2 lg:max-w-xs">
                  <div className="rounded-2xl border border-indigo-100/70 bg-indigo-50/60 p-4 text-left shadow-sm">
                    <p className="text-xs font-semibold uppercase tracking-wide text-indigo-600">实时预览</p>
                    <p className="mt-1 text-sm leading-relaxed text-slate-600">
                      内置 PDF / DOCX 视觉展示及原文文本抽取，保持上下文连续性。
                    </p>
                  </div>
                  <div className="rounded-2xl border border-purple-100/70 bg-purple-50/60 p-4 text-left shadow-sm">
                    <p className="text-xs font-semibold uppercase tracking-wide text-purple-600">极速导出</p>
                    <p className="mt-1 text-sm leading-relaxed text-slate-600">
                      一键导出 TXT、Markdown、DOCX 或 PDF，满足不同交付场景。
                    </p>
                  </div>
                </div>
              </div>
              <div className="mt-8 grid gap-4 md:grid-cols-3">
                {heroHighlights.map((item) => (
                  <div
                    key={item.title}
                    className="flex items-start gap-3 rounded-2xl border border-white/70 bg-white/80 p-4 shadow-sm shadow-indigo-100/50 backdrop-blur"
                  >
                    <div className="mt-1 flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-500/80 to-purple-500/80 text-sm font-semibold text-white">
                      {item.title.slice(0, 1)}
                    </div>
                    <div>
                      <h3 className="text-sm font-semibold text-slate-900">{item.title}</h3>
                      <p className="mt-1 text-xs leading-relaxed text-slate-600">{item.description}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div className="mx-auto mt-10 max-w-7xl px-6 pb-16">
            <div className="grid gap-8 lg:grid-cols-[320px_1fr]">
              {/* 左侧控制面板 */}
              <div className="space-y-6">
            {/* 文件上传卡片 */}
            <div className="rounded-2xl border border-white/70 bg-white/80 p-6 shadow-lg shadow-indigo-100/60 backdrop-blur">
              <div className="flex items-center gap-3 mb-4">
                <div className="flex h-10 w-10 items-center justify-center rounded-lg bg-gradient-to-br from-blue-500 to-indigo-600">
                  <svg className="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                  </svg>
                </div>
                <div>
                  <h3 className="font-semibold text-slate-900">上传文档</h3>
                  <p className="text-xs text-slate-500">支持多种格式</p>
                </div>
              </div>

              <div className="rounded-xl border-2 border-dashed border-indigo-200/60 bg-indigo-50/60 p-6 text-center transition-colors hover:bg-indigo-50 hover:border-indigo-300/80">
                <input
                  ref={fileInputRef}
                  type="file"
                  accept=".pdf,.doc,.docx,.md,.txt,.rtf,.markdown,.html,.ppt,.pptx,.xls,.xlsx,.csv"
                  onChange={handleFileChange}
                  className="hidden"
                />
                {selectedFile ? (
                  <div className="space-y-3">
                    <div className="flex items-center justify-center">
                      <div className="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                        <svg className="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      </div>
                    </div>
                    <p className="truncate text-sm font-medium text-slate-900">{selectedFile.name}</p>
                    <p className="text-xs text-slate-500">{formatFileSize(selectedFile.size)}</p>
                    <div className="flex gap-2 justify-center">
                      <button
                        type="button"
                        onClick={() => fileInputRef.current?.click()}
                        className="rounded-lg border border-slate-200 bg-white/80 px-3 py-1.5 text-xs font-medium text-slate-600 transition hover:bg-white"
                      >
                        更换文件
                      </button>
                      <button
                        type="button"
                        onClick={handleRemoveFile}
                        className="rounded-lg bg-red-50 px-3 py-1.5 text-xs font-medium text-red-600 transition hover:bg-red-100"
                      >
                        移除
                      </button>
                    </div>
                  </div>
                ) : (
                  <div className="space-y-3">
                    <div className="flex justify-center">
                      <svg className="h-12 w-12 text-indigo-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                    </div>
                    <p className="text-sm text-slate-600">拖拽文件到此处或点击上传</p>
                    <button
                      type="button"
                      onClick={() => fileInputRef.current?.click()}
                      className="rounded-lg bg-gradient-to-r from-blue-500 to-indigo-600 px-4 py-2 text-sm font-medium text-white transition-all hover:from-blue-600 hover:to-indigo-700"
                    >
                      选择文件
                    </button>
                    <p className="text-xs text-slate-500">支持 PDF、Word、TXT 等格式</p>
                  </div>
                )}
              </div>
            </div>

            {/* 翻译设置 */}
            <div className="rounded-2xl border border-white/70 bg-white/80 p-6 shadow-lg shadow-indigo-100/60 backdrop-blur">
              <div className="flex items-center gap-3 mb-4">
                <div className="flex h-10 w-10 items-center justify-center rounded-lg bg-gradient-to-br from-purple-500 to-pink-600">
                  <svg className="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.23 5.012 5.432 0 3.432 0 1.25 3.2 1.25 7v3c0 4.418 2.690 8.167 6.5 9.75" />
                  </svg>
                </div>
                <div>
                  <h3 className="font-semibold text-slate-900">翻译设置</h3>
                  <p className="text-xs text-slate-500">配置翻译参数</p>
                </div>
              </div>

              <div className="space-y-4">
                <div>
                  <label className="mb-2 block text-sm font-medium text-slate-700">目标语言</label>
                  <input
                    value={targetLanguage}
                    onChange={(event) => setTargetLanguage(event.target.value)}
                    placeholder="如：英语、日语、法语"
                    className="w-full rounded-lg border border-slate-200 bg-white/80 px-4 py-2 text-sm text-slate-700 placeholder-slate-400 shadow-inner focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-200"
                  />
                </div>

                <div>
                  <label className="mb-2 block text-sm font-medium text-slate-700">翻译指令</label>
                  <textarea
                    value={inputText}
                    onChange={(event) => setInputText(event.target.value)}
                    placeholder="例如：请翻译成商务英语，保持专业语气和格式"
                    className="w-full resize-none rounded-lg border border-slate-200 bg-white/80 px-4 py-2 text-sm text-slate-700 placeholder-slate-400 shadow-inner focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-200"
                    rows={3}
                  />
                </div>

                <div>
                  <p className="mb-2 text-xs text-slate-500">快速模板</p>
                  <div className="grid grid-cols-2 gap-2">
                    {translationPresets.map((preset) => (
                      <button
                        key={preset}
                        onClick={() => setSelectedPreset((prev) => (prev === preset ? null : preset))}
                        className={clsx(
                          'rounded-lg border px-3 py-2 text-xs font-medium transition-all',
                          selectedPreset === preset
                            ? 'bg-gradient-to-r from-indigo-500 to-purple-600 text-white border-transparent'
                            : 'border-slate-200 bg-white/80 text-slate-700 hover:border-indigo-200 hover:bg-indigo-50/70'
                        )}
                        type="button"
                      >
                        {preset}
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            {/* 操作按钮 */}
            <button
              type="button"
              onClick={handleExecute}
              disabled={isTranslating || !selectedFile}
              className={clsx(
                'w-full rounded-xl px-6 py-3 font-medium text-white transition-all transform hover:scale-[1.02] active:scale-[0.98]',
                !selectedFile || isTranslating
                  ? 'cursor-not-allowed bg-slate-200 text-slate-400'
                  : 'bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 shadow-lg shadow-indigo-200/70 hover:from-indigo-600 hover:via-purple-500 hover:to-pink-500 hover:shadow-indigo-300/70'
              )}
            >
              {isTranslating ? (
                <span className="flex items-center justify-center gap-2">
                  <svg className="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                    <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                    <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  正在翻译...
                </span>
              ) : (
                '开始翻译'
              )}
            </button>
            {translationError && (
              <div className="p-3 bg-red-50 border border-red-200 rounded-lg">
                <p className="text-sm text-red-600">{translationError}</p>
              </div>
            )}
          </div>

          {/* 右侧翻转卡片区域 */}
          <div className="perspective-1000">
            <div
              className={clsx(
                'relative w-full h-[600px] transition-transform duration-700 transform-style-preserve-3d',
                isFlipped ? 'rotate-y-180' : ''
              )}
            >
              {/* 正面 - 原文预览 */}
              <div className="absolute inset-0 backface-hidden rounded-2xl border border-white/70 bg-white/85 p-6 shadow-xl shadow-indigo-100/60 backdrop-blur">
                <div className="flex items-center justify-between mb-4">
                  <div className="flex items-center gap-3">
                    <div className="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-green-500 to-teal-600">
                      <svg className="h-4 w-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                    </div>
                    <div>
                      <h3 className="font-semibold text-slate-900">原文预览</h3>
                      <p className="text-xs text-slate-500">
                        {selectedFile ? extractExtension(selectedFile.name).toUpperCase() : '等待上传'}
                      </p>
                    </div>
                  </div>
                  <button
                    onClick={() => setIsFlipped(true)}
                    disabled={!hasTranslation}
                    className={clsx(
                      'rounded-lg bg-gradient-to-r from-indigo-500 to-purple-600 px-3 py-1.5 text-xs font-medium text-white transition-all hover:from-indigo-600 hover:to-purple-700',
                      !hasTranslation && 'cursor-not-allowed opacity-50'
                    )}
                  >
                    查看翻译结果
                  </button>
                </div>

                <div className="h-[500px] overflow-y-auto rounded-lg border border-indigo-100/60 bg-indigo-50/70 p-4">
                  {!selectedFile && (
                    <div className="flex h-full flex-col items-center justify-center text-slate-400">
                      <svg className="mb-4 h-16 w-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      <p className="text-center">请先上传文档</p>
                      <p className="text-sm text-center">支持 PDF、Word、TXT 等格式</p>
                    </div>
                  )}
                  {selectedFile && originalPreviewState.status === 'loading' && (
                    <div className="flex items-center justify-center h-full">
                      <div className="text-center">
                        <svg className="mx-auto mb-4 h-8 w-8 animate-spin text-indigo-600" fill="none" viewBox="0 0 24 24">
                          <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                          <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <p className="text-slate-500">正在加载文档...</p>
                      </div>
                    </div>
                  )
                  }
                  {selectedFile && originalPreviewState.status === 'error' && (
                    <div className="flex items-center justify-center h-full">
                      <div className="text-center">
                        <svg className="mx-auto mb-4 h-12 w-12 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77.833-1.964.833-3.364 0l-3-2.5c-.77-.833-1.964-.833-2.364 0z" />
                        </svg>
                        <p className="text-sm text-red-600">{originalPreviewState.message}</p>
                      </div>
                    </div>
                  )
                  }
                  {selectedFile && originalPreviewState.status === 'ready' && (
                    <OriginalPreview
                      previewState={originalPreviewState}
                      fileName={selectedFile.name}
                    />
                  )
                  }
                </div>
              </div>

              {/* 背面 - 翻译结果 */}
              <div className="absolute inset-0 backface-hidden rotate-y-180 rounded-2xl border border-white/70 bg-white/85 p-6 shadow-xl shadow-indigo-100/60 backdrop-blur">
                <div className="flex items-center justify-between mb-4">
                  <div className="flex items-center gap-3">
                    <div className="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-purple-500 to-pink-600">
                      <svg className="h-4 w-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.23 5.012 5.432 0 3.432 0 1.25 3.2 1.25 7v3c0 4.418 2.690 8.167 6.5 9.75" />
                      </svg>
                    </div>
                    <div>
                      <h3 className="font-semibold text-slate-900">翻译结果</h3>
                      <p className="text-xs text-slate-500">
                        {hasTranslation ? '翻译完成' : '等待翻译'}
                      </p>
                    </div>
                  </div>
                  <div className="flex gap-2">
                    <button
                      onClick={() => setPreviewMode('translation')}
                      className={clsx(
                        'rounded-lg px-3 py-1.5 text-xs font-medium transition-all',
                        previewMode === 'translation'
                          ? 'bg-indigo-100/90 text-indigo-700'
                          : 'bg-slate-100/80 text-slate-600 hover:bg-slate-200/70'
                      )}
                    >
                      纯译文
                    </button>
                    <button
                      onClick={() => setPreviewMode('comparison')}
                      disabled={!hasComparisonView}
                      className={clsx(
                        'rounded-lg px-3 py-1.5 text-xs font-medium transition-all',
                        !hasComparisonView
                          ? 'cursor-not-allowed bg-slate-100/80 text-slate-400'
                          : previewMode === 'comparison'
                            ? 'bg-indigo-100/90 text-indigo-700'
                            : 'bg-slate-100/80 text-slate-600 hover:bg-slate-200/70'
                      )}
                    >
                      对照模式
                    </button>
                    <button
                      onClick={() => setIsFlipped(false)}
                      className="rounded-lg bg-slate-100/80 px-3 py-1.5 text-xs font-medium text-slate-600 transition hover:bg-slate-200/70"
                    >
                      返回原文
                    </button>
                  </div>
                </div>

                <div className="h-[500px] overflow-y-auto rounded-lg border border-indigo-100/60 bg-indigo-50/70 p-4">
                  {isTranslating && (
                    <div className="flex h-full items-center justify-center">
                      <div className="text-center">
                        <svg className="mx-auto mb-4 h-8 w-8 animate-spin text-purple-600" fill="none" viewBox="0 0 24 24">
                          <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                          <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <p className="text-slate-500">AI正在翻译中...</p>
                      </div>
                    </div>
                  )}

                  {!isTranslating && (
                    <div className="space-y-4">
                      {showComparison ? (
                        <div className="space-y-4">
                          {comparisonPairs.map((pair, index) => (
                            <div key={pair.index} className="rounded-lg border border-white/70 bg-white/80 p-4 shadow-sm shadow-indigo-100/40 backdrop-blur">
                              <div className="mb-2 flex items-center gap-2">
                                <span className="rounded-full bg-indigo-50/80 px-2 py-1 text-xs font-medium text-indigo-600">
                                  段落 {index + 1}
                                </span>
                              </div>
                              <div className="grid gap-4 md:grid-cols-2">
                                <div>
                                  <p className="mb-1 text-xs text-slate-500">原文</p>
                                  <div className="rounded-lg border border-indigo-100/60 bg-indigo-50/70 p-3 text-sm text-slate-700">
                                    <pre className="whitespace-pre-wrap break-words">{pair.source || '暂无原文'}</pre>
                                  </div>
                                </div>
                                <div>
                                  <p className="mb-1 text-xs text-slate-500">译文</p>
                                  <div className="rounded-lg border border-indigo-100/60 bg-white/90 p-3 text-sm text-slate-900 shadow-inner">
                                    <pre className="whitespace-pre-wrap break-words">{pair.target}</pre>
                                  </div>
                                </div>
                              </div>
                            </div>
                          ))}
                        </div>
                      ) : (
                        <div className="prose prose-sm max-w-none">
                          <pre className="whitespace-pre-wrap break-words text-sm leading-relaxed text-slate-900">
                            {translationViewText}
                          </pre>
                        </div>
                      )}
                    </div>
                  )}
                </div>

                {/* 导出功能 */}
                {hasTranslation && (
                  <div className="mt-4 border-t border-indigo-100/60 pt-4">
                    <div className="mb-3 flex items-center justify-between">
                      <h4 className="text-sm font-medium text-slate-900">导出译文</h4>
                      <div className="flex items-center gap-2">
                        {exportOptions.map((option) => (
                          <button
                            key={option.id}
                            onClick={() => setSelectedExport(option.id)}
                            className={clsx(
                              'rounded-md px-2 py-1 text-xs transition-all',
                              selectedExport === option.id
                                ? 'bg-indigo-100/90 text-indigo-700'
                                : 'bg-slate-100/80 text-slate-600 hover:bg-slate-200/70'
                            )}
                          >
                            {option.id.toUpperCase()}
                          </button>
                        ))}
                      </div>
                    </div>
                    <button
                      onClick={handleExport}
                      disabled={isExporting}
                      className={clsx(
                        'w-full rounded-lg px-4 py-2.5 font-medium text-white transition-all',
                        isExporting
                          ? 'cursor-not-allowed bg-slate-300 text-slate-500'
                          : 'bg-gradient-to-r from-teal-500 via-emerald-500 to-green-500 shadow-lg shadow-emerald-100/60 hover:from-teal-600 hover:via-emerald-500 hover:to-green-500'
                      )}
                    >
                      {isExporting ? '正在导出...' : '下载译文'}
                    </button>
                    {exportMessage && (
                      <div className={clsx(
                        'rounded-lg p-3 text-xs',
                        exportMessage.kind === 'success'
                          ? 'bg-emerald-50 text-emerald-600'
                          : exportMessage.kind === 'error'
                            ? 'bg-red-50 text-red-600'
                            : 'bg-indigo-50 text-indigo-600'
                      )}>
                        {exportMessage.text}
                      </div>
                    )}
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
      {isCompareWindowOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 px-4 py-8">
          <div className="relative flex h-full w-full max-w-[1100px] flex-col rounded-3xl border border-[#E4E7FF] bg-white shadow-2xl lg:h-[90vh]">
            <header className="flex items-center justify-between border-b border-[#E8EAFE] px-6 py-4">
              <div>
                <h2 className="text-sm font-semibold text-slate-900">原文 / 译文全屏对照</h2>
                <p className="text-[11px] text-slate-500">
                  {selectedFile ? selectedFile.name : '未选择文件'} · 目标语言：{targetLanguage || '未填写'}
                </p>
              </div>
              <div className="flex gap-2">
                <button
                  type="button"
                  onClick={() => setCompareViewMode(compareViewMode === 'side-by-side' ? 'flip' : 'side-by-side')}
                  className={clsx(
                    'rounded-full px-4 py-1 text-[11px] transition font-medium',
                    compareViewMode === 'side-by-side'
                      ? 'bg-gradient-to-r from-indigo-500 to-purple-600 text-white'
                      : 'bg-gradient-to-r from-purple-500 to-pink-600 text-white'
                  )}
                >
                  {compareViewMode === 'side-by-side' ? '📖 左右对照' : '🔄 翻转模式'}
                </button>
                <button
                  type="button"
                  onClick={() => setPreviewMode('translation')}
                  className={clsx(
                    'rounded-full px-4 py-1 text-[11px] transition',
                    previewMode === 'translation'
                      ? 'bg-[#EEF0FF] text-[#4338CA]'
                      : 'bg-[#F6F7FF] text-slate-500 hover:bg-[#EEF0FF]'
                  )}
                >
                  仅显示译文
                </button>
                <button
                  type="button"
                  onClick={() => setPreviewMode('comparison')}
                  disabled={!hasComparisonView}
                  className={clsx(
                    'rounded-full px-4 py-1 text-[11px] transition',
                    !hasComparisonView
                      ? 'cursor-not-allowed bg-[#F3F4FF] text-slate-400'
                      : previewMode === 'comparison'
                        ? 'bg-[#EEF0FF] text-[#4338CA]'
                        : 'bg-[#F6F7FF] text-slate-500 hover:bg-[#EEF0FF]'
                  )}
                >
                  段落对照
                </button>
                <button
                  type="button"
                  onClick={() => setIsCompareWindowOpen(false)}
                  className="rounded-full border border-[#E4E7FF] px-4 py-1 text-[11px] text-slate-500 transition hover:bg-[#F6F7FF]"
                >
                  关闭
                </button>
              </div>
            </header>
            <div className="flex-1 overflow-hidden px-6 py-4">
              {compareViewMode === 'side-by-side' ? (
                // 左右对照模式
                <div className="grid h-full gap-4 overflow-hidden lg:grid-cols-2">
                  <div className="flex flex-col overflow-hidden rounded-2xl border border-[#E4E7FF] bg-[#FBFBFF]">
                    <div className="border-b border-[#E4E7FF] px-4 py-2 text-xs font-semibold text-slate-600">
                      原文
                    </div>
                    <div className="flex-1 overflow-y-auto px-4 py-3 text-sm text-slate-600">
                      {comparisonSourceText ? (
                        <pre className="whitespace-pre-wrap break-words">{comparisonSourceText}</pre>
                      ) : originalPreviewState.status === 'ready' ? (
                        <span className="text-xs text-slate-400">当前文件仅返回部分文本，可下载原文查看完整版。</span>
                      ) : (
                        <span className="text-xs text-slate-400">原文尚未加载或当前格式不支持文本抽取。</span>
                      )}
                    </div>
                  </div>
                  <div className="flex flex-col overflow-hidden rounded-2xl border border-[#E4E7FF] bg-[#FBFBFF]">
                    <div className="border-b border-[#E4E7FF] px-4 py-2 text-xs font-semibold text-slate-600">
                      译文
                    </div>
                    <div className="flex-1 overflow-y-auto px-4 py-3 text-sm text-slate-600">
                      {showComparison && hasComparisonView ? (
                        <div className="space-y-3">
                          {comparisonPairs.map((pair) => (
                            <div key={pair.index} className="rounded-xl bg-white p-3 shadow-sm">
                              <p className="text-[11px] font-semibold text-[#6366F1]">段落 {pair.index + 1}</p>
                              <pre className="mt-1 whitespace-pre-wrap break-words text-slate-600">
                                {pair.target}
                              </pre>
                              {pair.source && (
                                <details className="mt-2 text-xs text-slate-500">
                                  <summary className="cursor-pointer text-[#4338CA]">显示原文片段</summary>
                                  <pre className="mt-1 whitespace-pre-wrap break-words text-slate-500">
                                    {pair.source}
                                  </pre>
                                </details>
                              )}
                            </div>
                          ))}
                        </div>
                      ) : (
                        <pre className="whitespace-pre-wrap break-words">{translationViewText}</pre>
                      )}
                    </div>
                  </div>
                </div>
              ) : (
                // 翻转模式
                <div className="perspective-1000 h-full">
                  <div
                    className={clsx(
                      'relative h-full transition-transform duration-700 transform-style-preserve-3d',
                      isCompareFlipped ? 'rotate-y-180' : ''
                    )}
                  >
                    {/* 正面 - 原文 */}
                    <div className="absolute inset-0 backface-hidden rounded-2xl border border-[#E4E7FF] bg-[#FBFBFF] p-6">
                      <div className="flex h-full flex-col">
                        <div className="border-b border-[#E4E7FF] pb-3 mb-4">
                          <h3 className="text-lg font-semibold text-slate-800 flex items-center gap-2">
                            <span className="w-6 h-6 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-lg flex items-center justify-center">
                              <span className="text-white text-xs font-bold">原</span>
                            </span>
                            原文内容
                          </h3>
                        </div>
                        <div className="flex-1 overflow-y-auto px-2">
                          {comparisonSourceText ? (
                            <pre className="whitespace-pre-wrap break-words text-sm text-slate-700 leading-relaxed">
                              {comparisonSourceText}
                            </pre>
                          ) : originalPreviewState.status === 'ready' ? (
                            <div className="text-center text-slate-400 mt-8">
                              <span className="text-sm">当前文件仅返回部分文本，可下载原文查看完整版。</span>
                            </div>
                          ) : (
                            <div className="text-center text-slate-400 mt-8">
                              <span className="text-sm">原文尚未加载或当前格式不支持文本抽取。</span>
                            </div>
                          )}
                        </div>
                        <div className="pt-4 border-t border-[#E4E7FF]">
                          <button
                            onClick={() => setIsCompareFlipped(true)}
                            className="w-full py-3 px-4 bg-gradient-to-r from-indigo-500 to-purple-600 text-white rounded-xl font-medium hover:from-indigo-600 hover:to-purple-700 transition-all transform hover:scale-[1.02]"
                          >
                            查看译文 →
                          </button>
                        </div>
                      </div>
                    </div>

                    {/* 背面 - 译文 */}
                    <div className="absolute inset-0 backface-hidden rotate-y-180 rounded-2xl border border-[#E4E7FF] bg-[#FBFBFF] p-6">
                      <div className="flex h-full flex-col">
                        <div className="border-b border-[#E4E7FF] pb-3 mb-4">
                          <h3 className="text-lg font-semibold text-slate-800 flex items-center gap-2">
                            <span className="w-6 h-6 bg-gradient-to-br from-purple-500 to-pink-600 rounded-lg flex items-center justify-center">
                              <span className="text-white text-xs font-bold">译</span>
                            </span>
                            翻译结果
                          </h3>
                        </div>
                        <div className="flex-1 overflow-y-auto px-2">
                          {showComparison && hasComparisonView ? (
                            <div className="space-y-4">
                              {comparisonPairs.map((pair) => (
                                <div
                                  key={pair.index}
                                  className="rounded-xl border border-white/70 bg-white/85 p-4 shadow-sm shadow-indigo-100/40 backdrop-blur"
                                >
                                  <div className="mb-3 flex items-center gap-2">
                                    <span className="rounded-full bg-indigo-50/80 px-2 py-1 text-xs font-bold text-indigo-600">
                                      段落 {pair.index + 1}
                                    </span>
                                  </div>
                                  <pre className="whitespace-pre-wrap break-words text-sm text-slate-700 leading-relaxed">
                                    {pair.target}
                                  </pre>
                                  {pair.source && (
                                    <details className="mt-3 text-xs">
                                      <summary className="cursor-pointer font-medium text-indigo-600 transition hover:text-indigo-800">
                                        📄 查看原文片段
                                      </summary>
                                      <div className="mt-2 rounded-lg border border-indigo-100/60 bg-indigo-50/70 p-3">
                                        <pre className="whitespace-pre-wrap break-words text-slate-600">
                                          {pair.source}
                                        </pre>
                                      </div>
                                    </details>
                                  )}
                                </div>
                              ))}
                            </div>
                          ) : (
                            <pre className="whitespace-pre-wrap break-words text-sm text-slate-700 leading-relaxed">
                              {translationViewText}
                            </pre>
                          )}
                        </div>
                        <div className="border-t border-indigo-100/60 pt-4">
                          <button
                            onClick={() => setIsCompareFlipped(false)}
                            className="w-full transform rounded-xl bg-gradient-to-r from-purple-500 to-pink-600 px-4 py-3 font-medium text-white transition-all hover:scale-[1.02] hover:from-purple-600 hover:to-pink-700"
                          >
                            ← 返回原文
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      )}
    </>
  )
}
