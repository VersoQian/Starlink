# Supabase Postgres for the standalone KB/RAG backend.
# Copy this file to backend/.env.supabase.local, replace [YOUR-PASSWORD],
# then run Prisma with this env loaded.

# Direct connection. Works when your network supports IPv6.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.bwzaknpmxvksyamtrgae.supabase.co:5432/postgres?sslmode=require"

# If direct connection fails, use the Prisma/Supavisor Session pooler URL from:
# Supabase Dashboard -> Connect -> Prisma -> Supavisor Session pooler.
# DATABASE_URL="postgresql://postgres.bwzaknpmxvksyamtrgae:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

UPLOAD_DIR="./uploads"
PORT=4000
