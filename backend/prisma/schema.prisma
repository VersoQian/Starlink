generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String          @id @default(uuid())
  email     String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  knowledgeBases KnowledgeBase[]
}

model KnowledgeBase {
  id                String        @id @default(uuid())
  workspaceId       String?
  name              String
  aiChunkingEnabled Boolean       @default(true)
  status            KbStatus      @default(draft)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  publishedAt       DateTime?
  owner             User?         @relation(fields: [ownerId], references: [id])
  ownerId           String?
  seeds             Seed[]
  documents         Document[]
  tasks             ImportTask[]
  chunks            KnowledgeChunk[]

  @@index([workspaceId])
}

model Seed {
  id        String   @id @default(uuid())
  text      String
  createdAt DateTime @default(now())
  kb        KnowledgeBase @relation(fields: [kbId], references: [id])
  kbId      String
}

model Document {
  id        String   @id @default(uuid())
  title     String
  path      String
  mime      String
  size      Int
  sourceType DocumentSourceType
  createdAt DateTime @default(now())
  kb        KnowledgeBase @relation(fields: [kbId], references: [id])
  kbId      String
}

model KnowledgeChunk {
  id         String   @id @default(uuid())
  kbId       String   @map("kb_id")
  sourceId   String   @map("source_id")
  sourceType String   @map("source_type")
  title      String?
  chunkIndex Int      @map("chunk_index")
  text       String
  embedding  Json
  tokenCount Int      @map("token_count")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  kb         KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)

  @@unique([kbId, sourceType, sourceId, chunkIndex])
  @@index([kbId])
  @@index([sourceId])
  @@map("knowledge_chunks")
}

model ImportTask {
  id        String          @id @default(uuid())
  type      ImportTaskType
  payload   Json
  status    ImportStatus    @default(pending)
  error     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  kb        KnowledgeBase   @relation(fields: [kbId], references: [id])
  kbId      String
}

model Usage {
  id         String  @id @default(uuid())
  usedTokens BigInt  @default(0)
  limitTokens BigInt @default(100000000)
}

enum KbStatus {
  draft
  processing
  ready
}

enum ImportTaskType {
  seed
  file
  url
}

enum ImportStatus {
  pending
  processing
  succeeded
  failed
}

enum DocumentSourceType {
  file
  url
}
