DATABASE_URL="postgresql://user:password@localhost:5432/kb_dev?schema=public"
PORT=4000
INTERNAL_SERVICE_TOKEN=change-me
KB_TASK_SERVICE_URL=http://localhost:4001

# ============== Gateway Auth (Task D) ==============
# AUTH_MODE controls how the gateway resolves caller identity:
#   disabled (default): legacy `x-user-id` header trusted — preserves dev workflow.
#   jwt:                requires `Authorization: Bearer <HS256 token>` with payload
#                       `{ userId, workspaceIds: string[] | "all", exp? }`.
AUTH_MODE=disabled
# 32+ random chars recommended (e.g. `openssl rand -base64 48`). Required when AUTH_MODE=jwt.
AUTH_JWT_SECRET=

# ============== Gateway Limits & Telemetry (Task E) ==============
# Reject GraphQL queries deeper than this. Default 10.
GRAPHQL_MAX_DEPTH=10
# Per-userId token-bucket rate limit (requests per minute). Default 60.
RATE_LIMIT_PER_MIN=60
# Optional burst capacity (defaults to RATE_LIMIT_PER_MIN).
# RATE_LIMIT_BURST=120
# Operations slower than this (ms) are logged as `slow_query`. Default 5000.
SLOW_QUERY_MS=5000

# ============== Business LangGraph Configuration ==============
# LLM 配置（OpenAI 或兼容 API）
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LANGGRAPH_MODEL=gpt-4o-mini

# 自动 Critic 检测（可选，默认启用）
ENABLE_AUTO_CRITIC=true

# 跨文化技能与语义确认（可选，默认启用）
ENABLE_CULTURAL_SKILLS=true
ENABLE_SEMANTIC_PLAN=true

# ============== LangSmith Observability（可选 · Day-1） ==============
# LANGSMITH_TRACING 留空或设为 "false" 即完全关闭（不初始化 SDK，无 egress）
# 本地开启：LANGSMITH_TRACING=true 并粘贴个人 key（https://smith.langchain.com → Settings → API Keys）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=starlink-bmc-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 采样率 0.0–1.0，不设即为 1.0。超过 free tier 5k/月 时打开：
# LANGSMITH_SAMPLING_RATE=0.3

# Trace backend 路由（为 Phase-2 Langfuse 自托管预留）
# 可选值: "langsmith"（默认）| "langfuse"  — Day-1a 仅 langsmith 生效
TRACE_BACKEND=langsmith

# ============== OpenTelemetry (Wave 3 Agent C) ==============
# OTEL_ENABLED=true 启动 NodeSDK + auto-instrumentations(http/express/pg/graphql)
# 同时业务图（streamConversation / supervisor / sub-agent invoke / critic / debate）
# 会发射 manual span。LangSmith 与 OTel 可同时开启 — 各自独立导出。
# 关闭时（默认）：getTracer() 返回 no-op tracer，零运行时开销，零网络出站。
OTEL_ENABLED=false
# OTLP/HTTP 接收端 — Jaeger/OTel Collector/Honeycomb 都接 4318
# 例如本地 docker：docker run -p 4318:4318 jaegertracing/all-in-one:latest
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# resource.service.name — 用于在 backend UI 区分多个 starlink 进程
OTEL_SERVICE_NAME=starlink-server

# ============== Phase 4.2 · 异构 LLM Router（可选）==============
# agent.yaml 的 model 字段触发路由：
#   claude-* → ANTHROPIC_API_KEY + ANTHROPIC_BASE_URL（不设则回退 LLM_API_KEY）
#   deepseek-* → DEEPSEEK_API_KEY + DEEPSEEK_BASE_URL（默认 https://api.deepseek.com/v1）
#   gemini-* → GEMINI_API_KEY + GEMINI_BASE_URL
#   其他 → LLM_API_KEY + LLM_BASE_URL（现有默认）
# 不设这些 family 变量 → 全部回退到 LLM_* 单源（向后兼容）
# 团队设计示例：moderator 用 gpt-4o，opponent 用 deepseek-chat，generator 用 gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# GEMINI_API_KEY=
# GEMINI_BASE_URL=

# ============== Phase 4.1 · Debate B 触发开关 ==============
# DEBATE_ENABLED=true 时 critic 高严重冲突自动触发 market-agent ⇄ market-opponent ⇄ moderator 辩论
# 默认关；ablation 实验时按 case 翻
DEBATE_ENABLED=false

# ============== Phase 2.5 F5 · HITL 开关 ==============
# HITL_ENABLED=true 时 critic 高严重冲突触发 interrupt() 等 GraphQL resumeConversation
HITL_ENABLED=false

# ============== F2 · LangGraph PostgresSaver 持久化 ==============
# LANGGRAPH_CHECKPOINTER_ENABLED=true 时业务图每个节点过渡都会落到 PG `checkpoints`
# 表，按 thread_id（= conversationId）索引。开启后：
#   - 服务重启不丢 HITL 暂停态，可按 conversationId resume
#   - 多实例 gateway 共享同一份 PG → 任一实例都能 resume 任一会话
#   - DDL 自动建表，使用同一个 DATABASE_URL pool（不开第二条连接池）
# 默认关闭以确保单机/无 PG 场景照常工作。
LANGGRAPH_CHECKPOINTER_ENABLED=false

# ============== B · HITL pendingApprovals PG 持久化 ==============
# HITL_RUNTIME_DDL=true 启用 hitl-approval-store 自动 DDL（hitl_approvals 表）。
# 沿用 ConversationMemoryStore 的 runtime-DDL 习惯，生产环境建议显式跑 migrate
# 并把这个开关留 false 以避免每个进程重复 DDL。
HITL_RUNTIME_DDL=false
# 默认 TTL 秒数 — 决策没人审批就自动走 expire 路径
HITL_APPROVAL_DEFAULT_TTL_SEC=600

# ============== Phase 4.4 · 跨会话长期记忆 ==============
# MEMORY_READ_ENABLED：supervisor 注入 workspace 历史洞察到 prompt
# MEMORY_WRITE_ENABLED：会话末写入 summary memory（in-memory v1，重启即丢；v2 用 PostgresStore）
MEMORY_READ_ENABLED=false
MEMORY_WRITE_ENABLED=false

# ============== Phase 2 · Orchestration 模式开关 ==============
# legacy（默认）：原 supervisor 路径
# registry：Capability Registry 驱动 + 子图分派
ORCHESTRATION_MODE=registry

# ============== Legacy ComfyUI Configuration (已废弃) ==============
# 以下配置已不再使用，ComfyUI 功能已被 Business LangGraph 替代
# COMFYUI_BASE_URL=http://localhost:8188
# COMFYUI_TIMEOUT_MS=120000
# COMFYUI_WORKFLOW_PATH=packages/server/workflows/comfy-template.json
