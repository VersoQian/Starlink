generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [vector]
}

model KnowledgeVector {
  id        String   @id @default(uuid())
  docId     String
  chunk     String
  embedding Unsupported("vector(1536)")
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([docId])
}
