{
  "name": "@starlink/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit",
    "test": "pnpm --filter @starlink/shared build && pnpm run build && node --test dist/**/*.test.js",
    "smoke:access-subscriptions": "pnpm run build && node dist/scripts/smoke-access-subscriptions.js",
    "smoke:task-events": "pnpm run build && node dist/scripts/smoke-task-event-store.js",
    "smoke:conversation-runtime": "pnpm run build && node dist/scripts/smoke-conversation-runtime-store.js",
    "smoke:citation-pipeline": "pnpm run build && node dist/scripts/smoke-citation-pipeline.js",
    "smoke:all": "pnpm run build && node dist/scripts/smoke-task-event-store.js && node dist/scripts/smoke-conversation-runtime-store.js && node dist/scripts/smoke-access-subscriptions.js && node dist/scripts/smoke-citation-pipeline.js"
  },
  "dependencies": {
    "@apollo/server": "^4.11.2",
    "@graphql-tools/schema": "^10.0.13",
    "@langchain/core": "^1.1.12",
    "@langchain/langgraph": "^1.0.13",
    "@langchain/openai": "^1.2.1",
    "@starlink/shared": "workspace:*",
    "@supabase/supabase-js": "^2.78.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "graphql": "^16.11.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-tag": "^2.12.6",
    "graphql-type-json": "^0.3.2",
    "graphql-ws": "^6.0.6",
    "helmet": "^7.0.0",
    "ioredis": "^5.10.0",
    "morgan": "^1.10.0",
    "nanoid": "^5.0.7",
    "pg": "^8.14.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.7",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.10",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
